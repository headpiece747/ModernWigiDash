# Normalize line endings for all text files.
* text=auto

# Committed font files are binary — never normalize or diff them.
*.ttf binary

# Batch files must be CRLF on disk: cmd.exe misparses parenthesized
# if-blocks in LF-only files, and apply-update.cmd is embedded verbatim.
*.cmd text eol=crlf

# Git hooks must stay LF on disk: a CRLF line ending breaks the sh shebang
# and the command lines (the hooks run under Git's bundled sh, not cmd).
scripts/hooks/* text eol=lf
