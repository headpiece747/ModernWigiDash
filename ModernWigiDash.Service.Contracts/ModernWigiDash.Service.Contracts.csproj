<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ModernWigiDash.Service</RootNamespace>
    <AssemblyName>ModernWigiDash.Service.Contracts</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" />
    <!-- Direct reference lifts System.ServiceModel.Primitives' transitive
         System.Security.Cryptography.Xml off the vulnerable 10.0.0 (NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="System.ServiceModel.NetNamedPipe" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
  </ItemGroup>

</Project>
