<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Project global usings (P1 2026-08-21): namespaces every file in this
       assembly already needs; per-file restatements removed in the same pass. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Time.Testing" />
    <Using Include="ModernWigiDash.App" />
    <Using Include="ModernWigiDash.Core.Models" />
    <Using Include="ModernWigiDash.Sdk" />
    <Using Include="ModernWigiDash.Widgets" />
    <Using Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Core\ModernWigiDash.Core.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Hardware\ModernWigiDash.Hardware.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Widgets\ModernWigiDash.Widgets.csproj" />
    <ProjectReference Include="..\ModernWigiDash.App\ModernWigiDash.App.csproj" />
  </ItemGroup>

  <!-- Media-decode fixtures (MediaDecoderTests): a partial-delta GIF (the
       CopyTo/GetPixels composite path), a full-frame GIF, and a 300-frame
       GIF that exceeds the frame-count cap. -->
  <ItemGroup>
    <None Update="media-fixtures\**\*.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
