<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- MTP native host under-copies package assemblies by default; force the
         full lock-file copy so the test app can load all referenced assemblies. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Project global usings (P1 2026-08-21): namespaces every file in this
       assembly already needs; per-file restatements removed in the same pass. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Time.Testing" />
    <Using Include="ModernWigiDash.App" />
    <Using Include="ModernWigiDash.Core.Models" />
    <Using Include="ModernWigiDash.Sdk" />
    <Using Include="ModernWigiDash.Widgets" />
    <Using Include="SkiaSharp" />
  </ItemGroup>

  <!-- The architecture tests (ArchitectureTests) need the repo root at run
       time: the house test command runs from a temp BaseOutputPath, so the
       test assembly location is not the repo. Embedded from the source path
       at build time. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModernWigiDashRepoRoot" Value="$(MSBuildProjectDirectory)/.." />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Core\ModernWigiDash.Core.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Hardware\ModernWigiDash.Hardware.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Widgets\ModernWigiDash.Widgets.csproj" />
    <ProjectReference Include="..\ModernWigiDash.App\ModernWigiDash.App.csproj" />
  </ItemGroup>

  <!-- Media-decode fixtures (MediaDecoderTests): a partial-delta GIF (the
       CopyTo/GetPixels composite path), a full-frame GIF, and a 300-frame
       GIF that exceeds the frame-count cap. -->
  <ItemGroup>
    <None Update="media-fixtures\**\*.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
