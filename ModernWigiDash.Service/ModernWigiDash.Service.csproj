<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ModernWigiDash.Service</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Logo\logo.ico</ApplicationIcon>
    <UserSecretsId>modernwigidash-service-debug</UserSecretsId>
  </PropertyGroup>

  <!-- Debug configuration: enable detailed logging -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="CoreWCF.Http" />
    <PackageReference Include="CoreWCF.NetNamedPipe" />
    <PackageReference Include="CoreWCF.Primitives" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- logo.ico: exe icon (keep in sync with ModernWigiDash.App/Resources/Logo/logo.ico) -->
    <Resource Include="Resources\Logo\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Core\ModernWigiDash.Core.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Hardware\ModernWigiDash.Hardware.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Service.Contracts\ModernWigiDash.Service.Contracts.csproj" />
  </ItemGroup>

</Project>
