<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ModernWigiDash.Service</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Logo\logo.ico</ApplicationIcon>
    <UserSecretsId>modernwigidash-service-debug</UserSecretsId>
    <!-- The Web SDK defaults to Server GC (one heap per core); this low-throughput
         IPC service needs neither the heaps nor the GC threads. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- Memory-conservation runtime tuning (works identically on small and large
       RAM machines): GC compacts past 30% memory load; 1 MB regions for this
       small heap cut GC bookkeeping and reserved virtual memory. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HighMemoryPercent" Value="30" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionSize" Value="1048576" />
  </ItemGroup>

  <!-- Debug configuration: enable detailed logging + XML docs for IDE IntelliSense -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- slopwatch-ignore: SW005 CS1591 is expected: XML docs exist for IDE IntelliSense only; documenting every public member of a debug-only docs build is not a code-quality requirement. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="CoreWCF.NetNamedPipe" />
    <PackageReference Include="CoreWCF.Primitives" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- logo.ico: exe icon (keep in sync with ModernWigiDash.App/Resources/Logo/logo.ico) -->
    <Resource Include="Resources\Logo\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Core\ModernWigiDash.Core.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Hardware\ModernWigiDash.Hardware.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Service.Contracts\ModernWigiDash.Service.Contracts.csproj" />
  </ItemGroup>

</Project>
