<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project global usings (P1 2026-08-21): namespaces every file in this
       assembly already needs; per-file restatements removed in the same pass. -->
  <ItemGroup>
    <Using Include="ModernWigiDash.Core.Models" />
    <Using Include="ModernWigiDash.Sdk" />
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Controls" />
    <Using Include="System.Windows.Media" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Core\ModernWigiDash.Core.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Hardware\ModernWigiDash.Hardware.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Widgets\ModernWigiDash.Widgets.csproj" />
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
  </ItemGroup>

  <!-- WinForms compile reference for the tray icon (ADR-0018): UseWindowsForms
       is deliberately NOT set because it adds global System.Drawing +
       System.Windows.Forms usings (to the WPF markup temp project included)
       that collide with the WPF System.Windows types. The explicit
       framework reference carries the same compile reference without the
       usings; the WinForms runtime assemblies already ship in the
       WindowsDesktop shared framework the WPF reference resolves to. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are enforced at the build, not advisory: no doc-code
         NoWarn in these projects, so an undocumented public member (CS1591)
         or a malformed doc comment (CS1570, CS1573, CS1574, CS1587,
         CS1734) is a build warning the gate's zero-warning bar catches.
         The Sdk alone escalates CS1591 to an error (its public surface is
         the cross-assembly widget plugin API). -->
    <!-- Dev builds must parse as "no version" (AppVersion.Parse maps 0.0.0 to
         null -> IsDevBuild, updater disabled). Without this, the SDK default
         1.0.0 makes dev builds look release-stamped and they nag at startup.
         build-release.ps1 overrides InformationalVersion (updater stamp) and
         FileVersion (Windows Details tab) with the release tag. -->
    <Version>0.0.0</Version>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Logo\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Memory-conservation runtime tuning (works identically on small and large
        RAM machines):
        - HighMemoryPercent=30: GC compacts and returns memory once load passes
          30% of physical RAM (default 90% means it never does on big machines).
        - RegionSize=1MB: .NET 10 regions sized for this app's small heap,
          cutting GC bookkeeping and reserved virtual memory.
        - ConserveMemory=5: keep the managed heap compact at the cost of more
          frequent collections, and auto-compact the LOH when it fragments.
          The steady-state heap is small (~32 MB) with a stable ~11 MB LOH
          (frame pool + telemetry buffers), so a tighter heap beats a larger
          one here; the extra collection activity is negligible at this
          allocation rate. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HighMemoryPercent" Value="30" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionSize" Value="1048576" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The variable font is owned by Core (FontHelper loads it from its own
         output); the App links that copy so the WPF pack URI
         (pack://application:,,,/Resources/Fonts/#Geist) resolves it. WPF
         renders the variable font's weights (the wght axis) — no static
         font instances are shipped. -->
    <Resource Include="..\ModernWigiDash.Core\Resources\Fonts\Geist-VariableFont_wght.ttf">
      <Link>Resources\Fonts\Geist-VariableFont_wght.ttf</Link>
    </Resource>
    <Resource Include="Resources\Logo\logo.png">
    </Resource>
    <!-- The tray (ADR-0018) loads a PHYSICAL ico next to the exe (the
         WinForms NotifyIcon icon is a File.Exists read, not a WPF pack URI),
         so logo.ico rides two item types: Resource embeds it (the XAML
         Window.Icon + WindowChrome pack URI resolve from the assembly blob,
         which works with no disk file at all) and None carries the copy to
         the output. A Resource item's CopyToOutputDirectory is dead
         metadata: the copy targets only walk Content/None/EmbeddedResource/
         Compile, so the ico never reached the output until the None item
         (caught by the live UIA pass 2026-08-25: the tray silently never
         came up and the N1 guard fell every close through to a normal exit). -->
    <Resource Include="Resources\Logo\logo.ico">
    </Resource>
    <None Include="Resources\Logo\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Update\apply-update.cmd" />
  </ItemGroup>
</Project>
