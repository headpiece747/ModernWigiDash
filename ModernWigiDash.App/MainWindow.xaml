<Window x:Class="ModernWigiDash.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="ModernWigiDash - Next-Generation .NET 10 Manager"
        WindowState="Maximized"
        MinHeight="700" MinWidth="1200"
        Background="{StaticResource BgDark}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (HEADER) -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBlue}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MODERN WIGIDASH" FontSize="16" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text=".NET 10 • Free-Form Canvas &amp; Dynamic Engine" FontSize="11" Foreground="{StaticResource AccentBlue}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Page Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="PanelPageTabs" Orientation="Horizontal"/>
                    <Button x:Name="BtnAddPage" Content="+ Add Page" Margin="6,0,0,0" Padding="12,6" Click="BtnAddPage_Click"/>
                </StackPanel>

                <!-- Right Mode Toggles & USB Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkSnapToGrid" Content="⚡ Snap to Grid" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" Checked="ChkSnapToGrid_Changed" Unchecked="ChkSnapToGrid_Changed"/>
                    <CheckBox x:Name="ChkEditMode" Content="🎨 Edit Mode" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" Checked="ChkEditMode_Changed" Unchecked="ChkEditMode_Changed"/>
                    <Border Background="#3F1418" BorderBrush="#8C1D18" BorderThickness="1" CornerRadius="16" Padding="12,6">
                        <TextBlock x:Name="TxtUsbStatus" Text="🔴 Connecting Hardware..." FontSize="12" FontWeight="SemiBold" Foreground="#FFB4AB"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: WIDGET CATALOG / DRAWER -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🗂️ WIDGET CATALOG" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                    
                    <TextBox x:Name="TxtSearchCatalog" Grid.Row="1" Margin="0,0,0,12" TextChanged="TxtSearchCatalog_TextChanged" Tag="Search widgets..."/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListCatalog">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header: Name + Badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="{StaticResource M3PrimaryContainer}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding DefaultGridSize}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource M3OnPrimaryContainer}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Category / Author -->
                                            <TextBlock Grid.Row="1" Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,8"/>

                                            <!-- Action Button -->
                                            <Button Grid.Row="2" Content="+ Place on Canvas" Click="BtnPlaceWidget_Click" Tag="{Binding PluginId}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER COLUMN: SKIA CANVAS PREVIEW -->
            <Grid Grid.Column="1" Background="{StaticResource BgDark}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#12141E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid>
                        <TextBlock Text="🖥️ LIVE WIGIDASH PREVIEW (1024 x 600 • 60 FPS)" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="💡 Tip: Drag widgets freely or toggle Snap to Grid!" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Viewbox scaling the exact 1024x600 hardware screen resolution -->
                <Viewbox Grid.Row="1" Margin="24">
                    <Border Width="1024" Height="600" Background="#12141D" BorderBrush="{StaticResource AccentRed}" BorderThickness="2" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect Color="#E53935" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
                        </Border.Effect>
                        <skia:SKElement x:Name="SkiaCanvas" PaintSurface="SkiaCanvas_PaintSurface"
                                        MouseDown="SkiaCanvas_MouseDown"
                                        MouseMove="SkiaCanvas_MouseMove"
                                        MouseUp="SkiaCanvas_MouseUp"/>
                    </Border>
                </Viewbox>
            </Grid>

            <!-- RIGHT COLUMN: PROPERTY INSPECTOR -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="⚙️ WIDGET PROPERTIES" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelProperties">
                            <!-- Empty State -->
                            <Border x:Name="PanelEmptyInspector" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="No Widget Selected" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Click or tap any widget on the center canvas to inspect and customize its settings in real time." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Active Inspector (Hidden when empty) -->
                            <StackPanel x:Name="PanelActiveInspector" Visibility="Collapsed">
                                <!-- Selected Widget Header -->
                                <Border Background="{StaticResource M3PrimaryContainer}" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtInspName" Text="Widget Name" FontSize="15" FontWeight="Bold" Foreground="{StaticResource M3OnPrimaryContainer}"/>
                                        <TextBlock x:Name="TxtInspId" Text="Instance ID: ..." FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Transform Properties -->
                                <TextBlock Text="📐 POSITION &amp; TRANSFORM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource M3Primary}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- X / Y -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8">
                                        <TextBlock Text="X Position (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPosX" TextChanged="Transform_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8">
                                        <TextBlock Text="Y Position (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPosY" TextChanged="Transform_Changed"/>
                                    </StackPanel>

                                    <!-- Width / Height -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,8">
                                        <TextBlock Text="Width (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtWidth" TextChanged="Transform_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,8">
                                        <TextBlock Text="Height (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtHeight" TextChanged="Transform_Changed"/>
                                    </StackPanel>

                                    <!-- ZIndex / Rotation -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,8">
                                        <TextBlock Text="Z-Index Layer" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtZIndex" TextChanged="Transform_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,8">
                                        <TextBlock Text="Rotation (°)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtRotation" TextChanged="Transform_Changed"/>
                                    </StackPanel>

                                    <!-- Opacity Slider -->
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Layer Opacity" FontSize="11" Foreground="White"/>
                                            <TextBlock x:Name="TxtOpacityVal" Text="100%" FontSize="11" Foreground="{StaticResource M3Primary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="SliderOpacity_ValueChanged" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Custom Properties Container -->
                                <TextBlock Text="🛠️ WIDGET SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource M3Primary}" Margin="0,8,0,8"/>
                                <StackPanel x:Name="PanelCustomProperties" Margin="0,0,0,20"/>

                                <!-- Delete Button -->
                                <Button Content="🗑️ Remove Widget from Canvas" Background="#7F1D1D" BorderBrush="#EF4444" Foreground="White" FontWeight="Bold" Margin="0,10,0,0" Click="BtnDeleteWidget_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#10121C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusTelemetry" Text="⚡ Engine: .NET 10.0 | Rendering: 60.0 FPS | Canvas: 1024 x 600" FontSize="11" Foreground="White" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtActiveCount" Text="Active Widgets: 0" FontSize="11" Foreground="{StaticResource AccentGreen}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Export Profile" Width="110" Height="26" Margin="4,0" FontSize="11" Click="BtnExport_Click"/>
                    <Button Content="📂 Import Profile" Width="110" Height="26" Margin="4,0" FontSize="11" Click="BtnImport_Click"/>
                    <Button Content="🧹 Clear Canvas" Width="100" Height="26" Margin="4,0" FontSize="11" Background="#7F1D1D" BorderBrush="#EF4444" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
