<Window x:Class="ModernWigiDash.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="ModernWigiDash - Next-Generation .NET 10"
        Icon="Resources/Logo/logo.ico"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Width="1680" Height="824"
        MinHeight="824" MinWidth="1680"
        FontFamily="{StaticResource PrimaryFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        Background="{DynamicResource BgDark}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (HEADER) -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/Logo/logo.png" Width="38" Height="38" Stretch="Uniform"
                           VerticalAlignment="Top" Margin="0,0,24,0"/>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="MODERN WIGIDASH" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Free-Form Canvas &amp; Dynamic Engine" FontSize="11" Foreground="{DynamicResource AccentBlue}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Page Tabs -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Padding="4,4" VerticalAlignment="Center">
                        <ScrollViewer x:Name="ScrollerPageTabs" HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Disabled" MaxWidth="800"
                                      MouseWheel="ScrollerPageTabs_MouseWheel">
                            <StackPanel x:Name="PanelPageTabs" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="BtnAddPage" Grid.Column="1" Content="+ Add Page" Margin="12,0,0,0" Padding="12,6" FontSize="12" VerticalAlignment="Center" Click="BtnAddPage_Click"/>
                </Grid>

                <!-- Right Mode Toggles & USB Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkSnapToGrid" Content="⚡ Snap to Grid" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" Checked="ChkSnapToGrid_Changed" Unchecked="ChkSnapToGrid_Changed"/>
                    <CheckBox x:Name="ChkEditMode" Content="🎨 Edit Mode" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" Checked="ChkEditMode_Changed" Unchecked="ChkEditMode_Changed"/>
                    <Button x:Name="BtnTheme" Content="🎨 Theme" Padding="12,6" Margin="0,0,16,0" Click="BtnTheme_Click"/>
                    <Border x:Name="UsbBadgeBorder" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="UsbStatusDot" Width="8" Height="8" Fill="{DynamicResource DangerBorder}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtUsbStatus" Text="WigiDash" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3Primary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: WIDGET CATALOG / DRAWER -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🗂️ WIDGET CATALOG" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    
                    <TextBox x:Name="TxtSearchCatalog" Grid.Row="1" Margin="0,0,0,12" TextChanged="TxtSearchCatalog_TextChanged" Tag="Search widgets..."/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListCatalog">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header: Name -->
                                            <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>

                                            <!-- Category / Author -->
                                            <TextBlock Grid.Row="1" Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8"/>

                                            <!-- Action Button -->
                                            <Button Grid.Row="2" Content="+ Place on Canvas" Click="BtnPlaceWidget_Click" Tag="{Binding PluginId}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER COLUMN: SKIA CANVAS PREVIEW -->
            <Grid Grid.Column="1" Background="{DynamicResource BgDark}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid>
                        <TextBlock Text="🖥️ LIVE WIGIDASH PREVIEW (1016 x 592 • 30 FPS)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="💡 Tip: Drag widgets freely or toggle Snap to Grid!" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 1:1 preview of the exact 1016x592 hardware screen resolution (no scaling => crisp text) -->
                <Border x:Name="PreviewFrame" Grid.Row="1" Width="1016" Height="592" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource BgDark}" BorderThickness="0" CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect Color="#870000" BlurRadius="25" ShadowDepth="0" Opacity="0.45"/>
                    </Border.Effect>
                    <skia:SKElement x:Name="SkiaCanvas" PaintSurface="SkiaCanvas_PaintSurface"
                                    MouseDown="SkiaCanvas_MouseDown"
                                    MouseMove="SkiaCanvas_MouseMove"
                                    MouseUp="SkiaCanvas_MouseUp"/>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: PROPERTY INSPECTOR -->
            <Border x:Name="InspectorPanel" Grid.Column="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="⚙️ WIDGET PROPERTIES" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelProperties">
                            <!-- Empty State -->
                            <Border x:Name="PanelEmptyInspector" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="No Widget Selected" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Click or tap any widget on the center canvas to inspect and customize its settings in real time." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Active Inspector (Hidden when empty) -->
                            <StackPanel x:Name="PanelActiveInspector" Visibility="Collapsed">
                                <!-- Selected Widget Header -->
                                <Border Background="{DynamicResource M3PrimaryContainer}" BorderBrush="{DynamicResource AccentRed}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtInspName" Text="Widget Name" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryContainer}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Transform Properties -->
                                <TextBlock Text="📐 POSITION &amp; TRANSFORM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3Primary}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- X / Y -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8">
                                        <TextBlock Text="X Position (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPosX" TextChanged="Transform_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8">
                                        <TextBlock Text="Y Position (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPosY" TextChanged="Transform_Changed"/>
                                    </StackPanel>

                                    <!-- Width / Height -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,8">
                                        <TextBlock Text="Width (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtWidth" TextChanged="Transform_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,8">
                                        <TextBlock Text="Height (px)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtHeight" TextChanged="Transform_Changed"/>
                                    </StackPanel>

                                    <!-- ZIndex / Rotation -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,8">
                                        <TextBlock Text="Z-Index Layer" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtZIndex" TextChanged="Transform_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,8">
                                        <TextBlock Text="Rotation (°)" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtRotation" TextChanged="Transform_Changed"/>
                                    </StackPanel>

                                    <!-- Opacity Slider -->
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Layer Opacity" FontSize="11" Foreground="White"/>
                                            <TextBlock x:Name="TxtOpacityVal" Text="100%" FontSize="11" Foreground="{DynamicResource M3Primary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="SliderOpacity_ValueChanged" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Custom Properties Container -->
                                <TextBlock Text="🛠️ WIDGET SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3Primary}" Margin="0,8,0,8"/>
                                <StackPanel x:Name="PanelCustomProperties" Margin="0,0,0,20"/>

                                <!-- Delete Button -->
                                <Button Content="🗑️ Remove Widget from Canvas" Background="{DynamicResource DangerBackground}" BorderBrush="{DynamicResource DangerBorder}" Foreground="White" FontWeight="Bold" Margin="0,10,0,0" Click="BtnDeleteWidget_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusTelemetry" Text=".NET 10 | Rendering: 30 FPS | Canvas: 1016 x 592" FontSize="11" Foreground="White" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtActiveCount" Text="Active Widgets: 0" FontSize="11" Foreground="{DynamicResource AccentGreen}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Export Profile" Width="120" Height="26" Margin="4,0" FontSize="11" Click="BtnExport_Click"/>
                    <Button Content="📂 Import Profile" Width="120" Height="26" Margin="4,0" FontSize="11" Click="BtnImport_Click"/>
                    <Button Content="🧹 Clear Canvas" Width="120" Height="26" Margin="4,0" FontSize="11" Background="{DynamicResource DangerBackground}" BorderBrush="{DynamicResource DangerBorder}" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
