<Application x:Class="ModernWigiDash.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Material 3 (M3) Red Dark Color Scheme -->
        <Color x:Key="BgDarkColor">#0F111A</Color>
        <Color x:Key="BgPanelColor">#161824</Color>
        <Color x:Key="BgCardColor">#1F2232</Color>
        <Color x:Key="BorderColor">#3B282A</Color>
        
        <!-- M3 Red Primary Tokens -->
        <Color x:Key="AccentRedColor">#E53935</Color>
        <Color x:Key="M3PrimaryColor">#FFB4AB</Color>
        <Color x:Key="M3PrimaryContainerColor">#8C1D18</Color>
        <Color x:Key="M3OnPrimaryContainerColor">#FFDAD6</Color>
        <Color x:Key="AccentGreenColor">#81C784</Color>
        <Color x:Key="TextPrimaryColor">#F4EFF4</Color>
        <Color x:Key="TextSecondaryColor">#E0C2C4</Color>

        <SolidColorBrush x:Key="BgDark" Color="{StaticResource BgDarkColor}"/>
        <SolidColorBrush x:Key="BgPanel" Color="{StaticResource BgPanelColor}"/>
        <SolidColorBrush x:Key="BgCard" Color="{StaticResource BgCardColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentRed" Color="{StaticResource AccentRedColor}"/>
        <SolidColorBrush x:Key="M3Primary" Color="{StaticResource M3PrimaryColor}"/>
        <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource M3PrimaryColor}"/>
        <SolidColorBrush x:Key="M3PrimaryContainer" Color="{StaticResource M3PrimaryContainerColor}"/>
        <SolidColorBrush x:Key="M3OnPrimaryContainer" Color="{StaticResource M3OnPrimaryContainerColor}"/>
        <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource AccentGreenColor}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>

        <!-- Modern M3 Red Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D1F23"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- M3 Red Primary Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderBrush" Value="#FF897D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Modern M3 Red Input Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
