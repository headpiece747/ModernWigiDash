<Application x:Class="ModernWigiDash.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Custom Titanium & Sunset Amber Scheme — values are overridden at runtime by app_theme.json -->
        <Color x:Key="BgDarkColor">#121214</Color>
        <Color x:Key="BgPanelColor">#1A1A1E</Color>
        <Color x:Key="BgCardColor">#26262B</Color>
        <Color x:Key="BorderColor">#3F3F46</Color>
        
        <!-- Primary & Secondary Accent Tokens -->
        <Color x:Key="AccentRedColor">#F59E0B</Color>
        <Color x:Key="M3PrimaryColor">#FBBF24</Color>
        <Color x:Key="M3PrimaryContainerColor">#3F3F46</Color>
        <Color x:Key="M3OnPrimaryContainerColor">#FBBF24</Color>
        <Color x:Key="AccentGreenColor">#10B981</Color>
        <Color x:Key="TextPrimaryColor">#FAFAFA</Color>
        <Color x:Key="TextSecondaryColor">#A1A1AA</Color>

        <!-- Interactive states & chrome extras -->
        <Color x:Key="ControlHoverColor">#3F3F46</Color>
        <Color x:Key="DropdownHoverColor">#2A2A30</Color>
        <Color x:Key="TitleBarColor">#0B0B0C</Color>
        <Color x:Key="StatusBarBackgroundColor">#0E0E10</Color>
        <Color x:Key="DangerBackgroundColor">#7F1D1D</Color>
        <Color x:Key="DangerBorderColor">#EF4444</Color>
        <Color x:Key="SuccessBackgroundColor">#064E3B</Color>
        <Color x:Key="SuccessBorderColor">#10B981</Color>

        <SolidColorBrush x:Key="BgDark" Color="{DynamicResource BgDarkColor}"/>
        <SolidColorBrush x:Key="BgPanel" Color="{DynamicResource BgPanelColor}"/>
        <SolidColorBrush x:Key="BgCard" Color="{DynamicResource BgCardColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentRed" Color="{DynamicResource AccentRedColor}"/>
        <SolidColorBrush x:Key="M3Primary" Color="{DynamicResource M3PrimaryColor}"/>
        <SolidColorBrush x:Key="AccentBlue" Color="{DynamicResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="M3PrimaryContainer" Color="{DynamicResource M3PrimaryContainerColor}"/>
        <SolidColorBrush x:Key="M3OnPrimaryContainer" Color="{DynamicResource M3OnPrimaryContainerColor}"/>
        <SolidColorBrush x:Key="AccentGreen" Color="{DynamicResource AccentGreenColor}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="ControlHover" Color="{DynamicResource ControlHoverColor}"/>
        <SolidColorBrush x:Key="DropdownHover" Color="{DynamicResource DropdownHoverColor}"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="{DynamicResource TitleBarColor}"/>
        <SolidColorBrush x:Key="StatusBarBackground" Color="{DynamicResource StatusBarBackgroundColor}"/>
        <SolidColorBrush x:Key="DangerBackground" Color="{DynamicResource DangerBackgroundColor}"/>
        <SolidColorBrush x:Key="DangerBorder" Color="{DynamicResource DangerBorderColor}"/>
        <SolidColorBrush x:Key="SuccessBackground" Color="{DynamicResource SuccessBackgroundColor}"/>
        <SolidColorBrush x:Key="SuccessBorder" Color="{DynamicResource SuccessBorderColor}"/>

