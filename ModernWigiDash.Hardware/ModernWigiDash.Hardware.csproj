<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Emit the XML doc file for editor hover (the Sdk's
         GenerateDocumentationFile is the precedent). Docs are advisory in
         these internal-first projects: the Sdk alone keeps the
         CS1591-as-error contract, so the six doc codes observed when the
         switch turned on (2026-08-25 build) are suppressed here instead of
         gated. Removing a NoWarn entry re-enforces that code. -->
    <NoWarn>$(NoWarn);CS1570;CS1573;CS1574;CS1587;CS1591;CS1734</NoWarn>
  </PropertyGroup>

  <!-- Project global usings (P1 2026-08-21): namespaces every file in this
       assembly already needs; per-file restatements removed in the same pass. -->
  <ItemGroup>
    <Using Include="ModernWigiDash.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="LibUsbDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Native libusb-1.0.dll required by LibUsbDotNet at runtime (the fallback
      USB backend). Provenance: the x64 runtime DLL shipped inside the
      LibUsbDotNet NuGet package (runtimes/win-x64/native) at the version
      pinned in Directory.Packages.props — copied here so it lands next to the
      app binaries. Keep it in sync with the LibUsbDotNet version: the
      driver/API version must match what the package expects.
    -->
    <None Include="libusb-1.0.dll" Link="libusb-1.0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TreatAsUsed>true</TreatAsUsed>
    </None>
  </ItemGroup>

</Project>
