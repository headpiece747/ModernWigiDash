<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are enforced at the build, not advisory: no doc-code
         NoWarn in these projects, so an undocumented public member (CS1591)
         or a malformed doc comment (CS1570, CS1573, CS1574, CS1587,
         CS1734) is a build warning the gate's zero-warning bar catches.
         The Sdk alone escalates CS1591 to an error (its public surface is
         the cross-assembly widget plugin API). -->
  </PropertyGroup>

  <!-- Project global usings (P1 2026-08-21): namespaces every file in this
       assembly already needs; per-file restatements removed in the same pass. -->
  <ItemGroup>
    <Using Include="ModernWigiDash.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="LibUsbDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Native libusb-1.0.dll required by LibUsbDotNet at runtime (the fallback
      USB backend). Provenance: the x64 runtime DLL shipped inside the
      LibUsbDotNet NuGet package (runtimes/win-x64/native) at the version
      pinned in Directory.Packages.props — copied here so it lands next to the
      app binaries. Keep it in sync with the LibUsbDotNet version: the
      driver/API version must match what the package expects.
    -->
    <None Include="libusb-1.0.dll" Link="libusb-1.0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TreatAsUsed>true</TreatAsUsed>
    </None>
  </ItemGroup>

</Project>
