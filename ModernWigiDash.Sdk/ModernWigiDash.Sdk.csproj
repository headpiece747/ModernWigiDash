<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Sdk is the external plugin contract — undocumented public surface
         is a build failure (CS1591), so the contract docs stay enforced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- Project global usings (P1 2026-08-21): namespaces every file in this
       assembly already needs; per-file restatements removed in the same pass. -->
  <ItemGroup>
    <Using Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
