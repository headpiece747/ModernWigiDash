<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project global usings (P1 2026-08-21): namespaces every file in this
       assembly already needs; per-file restatements removed in the same pass. -->
  <ItemGroup>
    <Using Include="ModernWigiDash.Sdk" />
    <Using Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWigiDash.Sdk\ModernWigiDash.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Emit the XML doc file for editor hover (the Sdk's
         GenerateDocumentationFile is the precedent). Docs are advisory in
         these internal-first projects: the Sdk alone keeps the
         CS1591-as-error contract, so the six doc codes observed when the
         switch turned on (2026-08-25 build) are suppressed here instead of
         gated. Removing a NoWarn entry re-enforces that code. -->
    <NoWarn>$(NoWarn);CS1570;CS1573;CS1574;CS1587;CS1591;CS1734</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\Fonts\Geist-VariableFont_wght.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
